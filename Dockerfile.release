# 运行阶段
FROM alpine:3.24

# buildx 自动注入目标平台（用于 COPY 对应预编译二进制）
ARG TARGETOS
ARG TARGETARCH

# 安装运行时依赖并清理缓存
RUN apk add --no-cache ca-certificates tzdata \
    && rm -rf /var/cache/apk/*

# 创建文件夹
RUN mkdir -p /app/config /app/data /app/assets

WORKDIR /app

# 复制配置文件
COPY ./config/config.yaml ./config/source.yaml /app/config/

# 复制宿主机预先交叉编译好的二进制
# 注意：构建上下文中必须包含 bin/ 目录，且文件名格式为 proxypool-<os>-<arch>
# 例如：bin/proxypool-linux-amd64, bin/proxypool-linux-arm64
COPY bin/proxypool-${TARGETOS}-${TARGETARCH} /app/proxypool

# 设置权限
RUN chmod +x /app/proxypool

# 设置时区
ENV TZ=Asia/Shanghai

# 暴露端口
EXPOSE 12580

# 启动命令
ENTRYPOINT ["/app/proxypool"]
CMD ["-d", "-c", "config/config.yaml"]

# 添加元数据标签
LABEL maintainer="proxypool@laibas.top" \
    description="ProxyPool Service"
